@startuml classes
title Sistema de Aluguel de Carros - Diagrama de Classes (v2)
skinparam classAttributeIconSize 0

enum Perfil {
  CLIENTE
  EMPRESA
  BANCO
}

enum StatusPedido {
  EM_ANALISE
  APROVADO
  REPROVADO
  CONTRATO_EXECUTADO
  CANCELADO
}

enum TipoProprietario {
  CLIENTE
  EMPRESA
  BANCO
}

class Usuario {
  - id : Long
  - login : String
  - senha : String  <<hash BCrypt>>
  - perfil : Perfil
}

class Cliente {
  - id : Long
  - rg : String
  - cpf : String
  - nome : String
  - endereco : String
  - profissao : String
}

class Rendimento {
  - id : Long
  - entidadeEmpregadora : String
  - valor : BigDecimal
}

abstract class Agente {
  - id : Long
  - nome : String
  - cnpj : String
}

class Empresa
class Banco

class Automovel {
  - id : Long
  - matricula : String
  - ano : int
  - marca : String
  - modelo : String
  - placa : String
  - tipoProprietario : TipoProprietario
  - proprietarioId : Long
}

class Pedido {
  - id : Long
  - dataCriacao : LocalDateTime
  - dataInicio : LocalDate
  - dataFim : LocalDate
  - status : StatusPedido
}

class Contrato {
  - id : Long
  - dataExecucao : LocalDate
}

class ContratoCredito {
  - id : Long
  - valor : BigDecimal
  - taxaJuros : BigDecimal
  - parcelas : int
}

Usuario "1" -- "0..1" Cliente
Usuario "1" -- "0..1" Agente
Usuario --> Perfil

Cliente "1" *-- "0..3" Rendimento
Agente <|-- Empresa
Agente <|-- Banco

Automovel --> TipoProprietario
note right of Automovel
  Propriedade de Cliente, Empresa ou Banco:
  tipoProprietario + proprietarioId
  (id do cliente ou do agente).
end note

Pedido "*" --> "1" Cliente : solicita
Pedido "*" --> "1" Automovel : refere-se a
Pedido "*" --> "0..1" Agente : avaliado por
Pedido --> StatusPedido
Pedido "1" *-- "0..1" Contrato
Contrato "*" --> "1" Agente : executado por
Contrato "1" *-- "0..1" ContratoCredito
ContratoCredito "*" --> "1" Banco : concedido por
@enduml
