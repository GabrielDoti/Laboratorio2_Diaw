# Copie pra .env (ou configure as variáveis na sua IDE) e preencha com os dados do Supabase.
# Supabase > Project Settings > Database > Connection string (JDBC)
DB_URL=jdbc:postgresql://aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_USER=postgres.SEU_PROJECT_REF
DB_PASSWORD=sua_senha_do_banco
CORS_ORIGIN=http://localhost:5173
SEED_ENABLED=true
